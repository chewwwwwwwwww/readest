<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17150" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="bookrack-controller">
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17122"/><capability name="Safe area layout guides" minToolsVersion="9.0"/></dependencies>
    <scenes><scene sceneID="bookrack-scene"><objects>
        <viewController id="bookrack-controller" sceneMemberID="viewController"><view key="view" contentMode="scaleToFill" id="bookrack-view">
            <rect key="frame" x="0" y="0" width="414" height="896"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews><imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="BookrackLaunch" translatesAutoresizingMaskIntoConstraints="NO" id="bookrack-mark"><rect key="frame" x="143" y="384" width="128" height="128"/><constraints><constraint firstAttribute="width" constant="128" id="mark-width"/><constraint firstAttribute="height" constant="128" id="mark-height"/></constraints></imageView></subviews>
            <viewLayoutGuide key="safeArea" id="bookrack-safe"/>
            <color key="backgroundColor" red="0.9647058824" green="0.9607843137" blue="0.9411764706" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <constraints><constraint firstItem="bookrack-mark" firstAttribute="centerX" secondItem="bookrack-view" secondAttribute="centerX" id="mark-center-x"/><constraint firstItem="bookrack-mark" firstAttribute="centerY" secondItem="bookrack-view" secondAttribute="centerY" id="mark-center-y"/></constraints>
        </view></viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="bookrack-responder" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
    </objects></scene></scenes>
    <resources><image name="BookrackLaunch" width="256" height="256"/></resources>
</document>
